btn.MouseButton1Click:Connect(function()
    eatOn = not eatOn
    mapRemoved = eatOn
    btn.Text = eatOn and "Auto Farm : ON" or "Auto Farm : OFF"
    statsLabel.Visible = eatOn
    
    if player.Character then
        unanchorCharacter(player.Character)
        for _, conn in pairs(connections) do if conn then conn:Disconnect() end end
        connections = {}
        applyAntiTrip(player.Character)
    end

    if eatOn then
        task.spawn(function()
            task.wait(3)
            if eatOn then
                pcall(function() remote:FireServer({Paused = true}) end)
            end
        end)
        
        task.spawn(function()
            while eatOn and gui.Parent do
                local events = getEvents()
                local currentMap = mapValue and mapValue.Value or nil
                local now = os.clock()

                if now - lastRewardCheck >= 0.5 then
                    lastRewardCheck = now
                    task.spawn(function()
                        local timedRewards = player:FindFirstChild("TimedRewards", true)
                        if timedRewards then
                            local rewardsList = timedRewards:GetChildren()
                            
                            for _, reward in ipairs(rewardsList) do
                                if reward.Name == "SmallReward" then
                                    rewardRemote:FireServer(reward)
                                    task.wait(0.2)
                                end
                            end
                            
                            for _, reward in ipairs(rewardsList) do
                                if reward.Name == "MediumReward" then
                                    rewardRemote:FireServer(reward)
                                    task.wait(0.2)
                                end
                            end
                            
                            for _, reward in ipairs(rewardsList) do
                                if reward.Name == "LargeReward" then
                                    rewardRemote:FireServer(reward)
                                    task.wait(0.2)
                                end
                            end
                        end
                    end)
                end

                if currentMap and allowed[currentMap] then
                    burstMapChange()
                end

                if now - lastEmote >= 7 then
                    burstMapChange()
                    lastEmote = now
                end

                if events then
                    local bar = findBar()
                    local grab, eat = events:FindFirstChild("Grab"), events:FindFirstChild("Eat")
                    
                    if bar and bar.Size.X.Scale >= 1 then
                        local sell = events:FindFirstChild("Sell")
                        if sell then sell:FireServer() end
                        if not barTriggered then
                            barTriggered = true
                            burstMapChange()
                            numSell = numSell + 1
                            if grab and eat then
                                grab:FireServer()
                                eat:FireServer()
                            end
                        end
                    elseif bar and bar.Size.X.Scale < 1 then
                        barTriggered = false
                    end
                    
                    if grab and eat then 
                        grab:FireServer() 
                        eat:FireServer() 
                    end
                end

                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    if char.HumanoidRootPart.Position.Y <= -400 then
                        char.HumanoidRootPart.CFrame = CFrame.new(0, 100, 0)
                        char.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
                    end
                end
                task.wait(0.01)
            end
        end)
    end

    if isProcessingMap then return end
    isProcessingMap = true
    if mapRemoved then
        local count = 0
        for _,v in pairs(workspace:GetChildren()) do
            if not Players:GetPlayerFromCharacter(v) and v ~= workspace.Terrain and not v:IsA("Camera") and not v:FindFirstChild("Events") then
                v.Parent = mapStorage
                count += 1
                if count % 100 == 0 then task.wait() end
            end
        end
        local floor = Instance.new("Part", workspace)
        floor.Name = "RemovedMapFloor"
        floor.Size = Vector3.new(100000,1,100000)
        floor.Position = Vector3.new(0,-1,0)
        floor.Anchored = true
        floor.Color = Color3.fromRGB(5,5,25)
    else
        local count = 0
        for _,v in pairs(mapStorage:GetChildren()) do
            v.Parent = workspace
            count += 1
            if count % 100 == 0 then task.wait() end
        end
        if workspace:FindFirstChild("RemovedMapFloor") then workspace.RemovedMapFloor:Destroy() end
    end
    isProcessingMap = false
end)

