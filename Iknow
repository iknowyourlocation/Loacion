local barTriggered = false

local function burstMapChange()
    task.spawn(function()
        for i = 1, 5 do
            pcall(function() remote:FireServer({MapTime = -1}) end)
        end
    end)
end

local function hookCharacter(char)
    local humanoid = char:WaitForChild("Humanoid", 5)
    if not humanoid then return end
    humanoid.AnimationPlayed:Connect(function(track)
        if track and track.Animation and track.Animation.AnimationId == "rbxassetid://16493281076" then
            lastEmote = os.clock()
            animCount = animCount + 1
        end
    end)
end

local function applyAntiTrip(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, not eatOn)
    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, not eatOn)
    if eatOn and (hum:GetState() == Enum.HumanoidStateType.FallingDown or hum:GetState() == Enum.HumanoidStateType.Ragdoll) then
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    local connection = hum.StateChanged:Connect(function(_, new)
        if eatOn and (new == Enum.HumanoidStateType.FallingDown or new == Enum.HumanoidStateType.Ragdoll) then
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end)
    table.insert(connections, connection)
end

RunService.Heartbeat:Connect(function()
    local currentTime = os.clock()
    if eatOn then
        local char = player.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = CFrame.new(726, hrp.Position.Y, 487) * CFrame.Angles(0, math.rad(90), 0)
            end
            unanchorCharacter(char)
        end
    end

    local bar = findBar()
    if bar then
        local scale = bar.Size.X.Scale
        if scale <= 0 then
            if not isBarGrowing then
                isBarGrowing = true
                barStartTime = currentTime
                animCount = 0
            end
        elseif scale >= 1 then
            if isBarGrowing then
                isBarGrowing = false
                lastGrowDuration = currentTime - barStartTime
            end
        end
    end

    local runTotal = currentTime - scriptStartTime
    statsLabel.Text = string.format("Runtime: %dh%dm%ds\nGrow time: %dm%ds\nnumChunk: %d\nnumSell: %d", 
        math.floor(runTotal / 3600), math.floor((runTotal % 3600) / 60), math.floor(runTotal % 60),
        math.floor(lastGrowDuration / 60), math.floor(lastGrowDuration % 60), 
        math.floor(animCount / 3), numSell)
end)

player.CharacterAdded:Connect(function(char)
    for _, conn in pairs(connections) do if conn then conn:Disconnect() end end
    connections = {}
    unanchorCharacter(char)
    applyAntiTrip(char)
    hookCharacter(char)
end)

if player.Character then
    unanchorCharacter(player.Character)
    applyAntiTrip(player.Character)
    hookCharacter(player.Character)
end

