local function getEvents()
    local p = workspace:FindFirstChild(player.Name)
    if not p then return end
    return p:FindFirstChild("Events")
end

local function findBar()
    if cachedBar and cachedBar.Parent then return cachedBar end
    for _,v in pairs(player.PlayerGui:GetDescendants()) do
        if v:IsA("Frame") and (v.Name:lower():find("bar") or v.Name:lower():find("meter")) then
            cachedBar = v
            return v
        end
    end
end

local function unanchorCharacter(char)
    if not char then return end
    for _, v in pairs(char:GetChildren()) do
        if v:IsA("BasePart") and v.Anchored then
            v.Anchored = false
        end
    end
end

